// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "Python 3",
	// Debian bullseye images are no longer published; use the current major on trixie.
	"image": "mcr.microsoft.com/devcontainers/python:3-3.13-trixie",

	// Python's sqlite3 module is built in; install the sqlite3 CLI for inspecting debug.sqlite.
	"onCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends sqlite3 && sudo rm -rf /var/lib/apt/lists/*",

	// Install the project's Python dependencies.
	"postCreateCommand": "pip3 install --user -r requirements.txt",

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"qwtel.sqlite-viewer"
			]
		}
	}

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
